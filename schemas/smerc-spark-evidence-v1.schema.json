{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smerc.example/schemas/smerc-spark-evidence-v1.schema.json",
  "title": "SMERC SPARK Evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "evidence_id", "collected_at", "source_systems", "action_metadata", "recoverability_signals", "evidence_gaps", "non_secret_boundary"],
  "properties": {
    "version": {"const": "smerc.spark-evidence.v1"},
    "evidence_id": {"$ref": "#/$defs/text"},
    "collected_at": {"type": "string", "format": "date-time"},
    "source_systems": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/text"}
    },
    "action_metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action_id", "description", "actor", "tool", "operation", "resource", "environment", "authority_basis", "authority_confidence", "external_side_effect", "sensitive_data"],
      "properties": {
        "action_id": {"$ref": "#/$defs/text"},
        "description": {"$ref": "#/$defs/text"},
        "actor": {"$ref": "#/$defs/text"},
        "tool": {"$ref": "#/$defs/text"},
        "operation": {"$ref": "#/$defs/text"},
        "resource": {"$ref": "#/$defs/text"},
        "environment": {"$ref": "#/$defs/text"},
        "authority_basis": {"$ref": "#/$defs/text"},
        "authority_confidence": {"$ref": "#/$defs/score"},
        "external_side_effect": {"type": "boolean"},
        "sensitive_data": {"type": "boolean"}
      }
    },
    "recoverability_signals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["base_action_risk", "reversibility", "containment_strength", "rollback_latency", "evidence_validity", "anomaly_pressure", "impact_scope", "cancel_reliability", "rollback_method"],
      "properties": {
        "base_action_risk": {"$ref": "#/$defs/score"},
        "reversibility": {"$ref": "#/$defs/score"},
        "containment_strength": {"$ref": "#/$defs/score"},
        "rollback_latency": {"$ref": "#/$defs/score"},
        "evidence_validity": {"$ref": "#/$defs/score"},
        "anomaly_pressure": {"$ref": "#/$defs/score"},
        "impact_scope": {"$ref": "#/$defs/score"},
        "cancel_reliability": {"$ref": "#/$defs/score"},
        "rollback_method": {"$ref": "#/$defs/text"}
      }
    },
    "evidence_gaps": {
      "type": "array",
      "maxItems": 16,
      "items": {"$ref": "#/$defs/text"}
    },
    "non_secret_boundary": {"const": true}
  },
  "$defs": {
    "score": {"type": "number", "minimum": 0, "maximum": 1},
    "text": {"type": "string", "minLength": 1, "maxLength": 512}
  }
}
