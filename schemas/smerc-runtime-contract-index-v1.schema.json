{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smerc.example/schemas/smerc-runtime-contract-index-v1.schema.json",
  "title": "SMERC Runtime Contract Index v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "purpose",
    "canonical_loop",
    "contracts",
    "handoff_rules",
    "interpretation_rules",
    "boundary"
  ],
  "properties": {
    "version": {
      "const": "smerc.runtime-contract-index.v1"
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "canonical_loop": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "contracts": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "layer",
          "contract",
          "owner",
          "role",
          "primary_artifacts",
          "hands_off_to",
          "claim_boundary"
        ],
        "properties": {
          "layer": {
            "type": "string",
            "minLength": 1
          },
          "contract": {
            "type": "string",
            "pattern": "^smerc\\.[a-z0-9_\\-.]+\\.v[0-9]+$|^smerc\\.spl\\.v0$"
          },
          "owner": {
            "enum": ["SMERC", "SPARTa", "DLL", "integration", "policy"]
          },
          "role": {
            "type": "string",
            "minLength": 1
          },
          "primary_artifacts": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "hands_off_to": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "claim_boundary": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "handoff_rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from", "to", "required_artifact", "rule"],
        "properties": {
          "from": {
            "type": "string",
            "minLength": 1
          },
          "to": {
            "type": "string",
            "minLength": 1
          },
          "required_artifact": {
            "type": "string",
            "minLength": 1
          },
          "rule": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "interpretation_rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "boundary": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
