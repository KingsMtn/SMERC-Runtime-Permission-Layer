{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smerc.example/schemas/smerc-beacon-v1.schema.json",
  "title": "SMERC Beacon v1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "name",
    "category",
    "canonical_site",
    "canonical_repository",
    "one_line_summary",
    "status",
    "postures",
    "core_questions",
    "governance_surfaces",
    "discovery_endpoints",
    "model_agent_fitness",
    "non_claims",
    "review_paths"
  ],
  "properties": {
    "schema_version": {"const": "smerc.beacon.v1"},
    "name": {"type": "string", "minLength": 1},
    "category": {"type": "string", "minLength": 1},
    "canonical_site": {"type": "string", "pattern": "^https://"},
    "canonical_repository": {"type": "string", "pattern": "^https://github.com/"},
    "one_line_summary": {"type": "string", "minLength": 1},
    "status": {"type": "string", "minLength": 1},
    "postures": {
      "type": "array",
      "items": {"enum": ["ALLOW", "THROTTLE", "FREEZE", "DENY", "ESCALATE"]},
      "minItems": 5,
      "uniqueItems": true
    },
    "core_questions": {"$ref": "#/$defs/string_list"},
    "governance_surfaces": {"$ref": "#/$defs/string_list"},
    "discovery_endpoints": {
      "type": "object",
      "required": ["llms", "humans", "project_profile", "beacon", "sitemap"],
      "additionalProperties": {"type": "string", "pattern": "^https://"}
    },
    "model_agent_fitness": {
      "type": "object",
      "required": ["purpose", "input_signals", "output_fields"],
      "properties": {
        "purpose": {"type": "string", "minLength": 1},
        "input_signals": {"$ref": "#/$defs/string_list"},
        "output_fields": {"$ref": "#/$defs/string_list"}
      }
    },
    "decision_language": {
      "type": "object",
      "required": ["version", "schema", "examples", "postures"],
      "properties": {
        "version": {"const": "smerc.decision.v1"},
        "schema": {"type": "string", "pattern": "^https://"},
        "examples": {"type": "string", "pattern": "^https://"},
        "postures": {
          "type": "array",
          "items": {"enum": ["ALLOW", "THROTTLE", "FREEZE", "DENY", "ESCALATE"]},
          "minItems": 5,
          "uniqueItems": true
        }
      }
    },
    "non_claims": {"$ref": "#/$defs/string_list"},
    "review_paths": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"type": "string", "pattern": "^https://"}
    }
  },
  "$defs": {
    "string_list": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
