{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smerc.example/schemas/smerc-sparta-vocabulary-v1.schema.json",
  "title": "SMERC SPARTa Vocabulary v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "lifecycle_verbs",
    "route_states",
    "control_verbs",
    "evidence_events",
    "failure_reasons",
    "adapter_interpretation",
    "boundary"
  ],
  "properties": {
    "version": {
      "const": "smerc.sparta-vocabulary.v1"
    },
    "lifecycle_verbs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "DECLARE",
          "PLAN",
          "ROUTE",
          "PREPARE",
          "EXECUTE",
          "CONSTRAIN",
          "HOLD",
          "BLOCK",
          "ESCALATE",
          "COLLECT_EVIDENCE",
          "APPEND_LEDGER"
        ]
      }
    },
    "route_states": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "EXECUTE",
          "CONSTRAINED_EXECUTE",
          "PAUSE",
          "BLOCK",
          "REVIEW_REQUIRED",
          "BLOCKED_ESCALATION_UNAVAILABLE"
        ]
      }
    },
    "control_verbs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "LIMIT_SCOPE",
          "PREVIEW_BEFORE_EXECUTION",
          "CHECKPOINT_BEFORE_EXECUTION",
          "REQUIRE_ROLLBACK_PLAN",
          "REQUIRE_HUMAN_APPROVAL",
          "PRESERVE_REPLAY",
          "REQUIRE_RECOVERY_PATH",
          "RATE_LIMIT_EXECUTION",
          "DELAY_SETTLEMENT",
          "REQUIRE_DUAL_CONTROL",
          "CANCEL_ON_SIGNAL_CHANGE",
          "REQUIRE_FRESH_EVIDENCE"
        ]
      }
    },
    "evidence_events": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "ROUTE_ISSUED",
          "ROUTE_VERIFIED",
          "PERMIT_VERIFIED",
          "CONTROL_APPLIED",
          "CONTROL_UNAVAILABLE",
          "EXECUTION_STARTED",
          "EXECUTION_BLOCKED",
          "EXECUTION_PAUSED",
          "EXECUTION_COMPLETED",
          "EXECUTION_FAILED",
          "ROLLBACK_STARTED",
          "ROLLBACK_COMPLETED",
          "ROLLBACK_FAILED",
          "REVIEW_REQUESTED",
          "REVIEW_COMPLETED",
          "LEDGER_APPENDED"
        ]
      }
    },
    "failure_reasons": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "UNKNOWN_ADAPTER",
          "UNSUPPORTED_ACTION",
          "UNSUPPORTED_CAPABILITY",
          "SCOPE_EXCEEDS_MAXIMUM",
          "CONTROL_UNSUPPORTED",
          "ROUTE_DIGEST_MISMATCH",
          "PERMIT_MISSING",
          "PERMIT_EXPIRED",
          "PERMIT_ALREADY_USED",
          "EVIDENCE_STALE",
          "REVIEW_PATH_UNAVAILABLE",
          "EXECUTION_RESULT_MISSING"
        ]
      }
    },
    "adapter_interpretation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unknown_term_behavior", "non_executable_states", "conditional_execution_states"],
      "properties": {
        "unknown_term_behavior": {
          "const": "fail_closed"
        },
        "non_executable_states": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["PAUSE", "BLOCK", "REVIEW_REQUIRED", "BLOCKED_ESCALATION_UNAVAILABLE"]
          }
        },
        "conditional_execution_states": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["EXECUTE", "CONSTRAINED_EXECUTE"]
          }
        }
      }
    },
    "boundary": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
