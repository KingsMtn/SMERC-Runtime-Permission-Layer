{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/KingsMtn/SMERC-Runtime-Permission-Layer/schemas/smerc-recoverability-metadata-v0.schema.json",
  "title": "SMERC Recoverability Metadata Contract v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "action_id",
    "action_type",
    "tool_system",
    "reversible",
    "rollback_latency_seconds",
    "external_side_effect",
    "blast_radius_scope",
    "evidence_available",
    "recommended_posture"
  ],
  "properties": {
    "version": {
      "const": "smerc.recoverability-metadata.v0"
    },
    "action_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "action_type": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "tool_system": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "reversible": {
      "type": "boolean"
    },
    "rollback_latency_seconds": {
      "type": "integer",
      "minimum": -1,
      "maximum": 604800,
      "description": "-1 means unknown."
    },
    "external_side_effect": {
      "type": "boolean"
    },
    "blast_radius_scope": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "evidence_available": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "recommended_posture": {
      "enum": ["ALLOW", "THROTTLE", "FREEZE", "DENY", "ESCALATE"]
    },
    "tooling_isolation": {
      "enum": ["none", "restricted_tools", "shell", "browser", "code_execution", "privileged_automation", "unknown"],
      "description": "Optional action-environment evidence. Describes the tools or execution powers available at the action boundary."
    },
    "host_isolation": {
      "enum": ["none", "process", "container", "hardened_container", "vm", "dedicated_account", "unknown"],
      "description": "Optional action-environment evidence. Describes how strongly the executing host is isolated."
    },
    "network_isolation": {
      "enum": ["none", "outbound_only", "scoped_private_network", "internet", "production_network", "unknown"],
      "description": "Optional action-environment evidence. Describes network reachability at execution time."
    },
    "sandbox_escape_surface": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": ["none_known", "docker_socket", "privileged_container", "host_mount", "cloud_metadata_access", "production_credentials", "unknown"]
      },
      "description": "Optional action-environment evidence. Lists known sandbox escape or privilege-escalation surfaces relevant to the proposed action."
    },
    "execution_environment_boundary": {
      "enum": ["local", "ci_runner", "mcp_server", "cloud_function", "bedrock_action_group", "kubernetes_workload", "production_host", "unknown"],
      "description": "Optional action-environment evidence. Names the boundary where the action would execute."
    },
    "confidence_hint": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "notes": {
      "type": "string",
      "maxLength": 500
    }
  }
}
